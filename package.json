{
  "name": "computer-use-automation-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Computer-use discovery agent + deterministic capability replay system for legacy back-office UIs.",
  "scripts": {
    "mock-app": "tsx mock-app/server.ts",
    "mock-app:lakeside": "MOCK_APP_PORT=4001 MOCK_APP_TENANT=lakeside tsx mock-app/server.ts",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "serve": "tsx src/cli.ts serve",
    "handoff": "tsx src/cli.ts handoff",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
